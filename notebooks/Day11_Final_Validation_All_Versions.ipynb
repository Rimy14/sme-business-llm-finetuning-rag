    "## Cell 9 — Interactive Final Model Demonstrator (SME Live Query)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sentence_transformers import SentenceTransformer\n",
    "import chromadb\n",
    "\n",
    "# Demonstrate live RAG answering with Llama 3 8B v4 (Best Sprint Model)\n",
    "CHROMA_DIR = os.path.join(PROJECT_ROOT, 'data', 'chroma_db')\n",
    "embedder = SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2', device='cuda' if torch.cuda.is_available() else 'cpu')\n",
    "chroma_client = chromadb.PersistentClient(path=CHROMA_DIR)\n",
    "chroma_col = chroma_client.get_or_create_collection(name='sme_sop_knowledge_base', metadata={\"hnsw:space\": \"cosine\"})\n",
    "\n",
    "sample_sme_scenarios = [\n",
    "    \"What is our policy for early customer invoice payment discounts and when does it apply?\",\n",
    "    \"Can an SME hire an operational manager under a 1099 independent contractor agreement?\",\n",
    "    \"How is the Reorder Point calculated for a Class-A inventory component?\",\n",
    "    \"What is the minimum gross profit margin required by policy for new business pricing?\"\n",
    "]\n",
    "\n",
    "print(\"💼 Demonstrating Live SME Knowledge Retrieval Across Top Enterprise Domains:\\n\" + \"=\"*80)\n",
    "for idx, query in enumerate(sample_sme_scenarios, 1):\n",
    "    q_emb = embedder.encode([query], normalize_embeddings=True).tolist()\n",
    "    res = chroma_col.query(query_embeddings=q_emb, n_results=1, include=['documents', 'metadatas', 'distances'])\n",
    "    sim = round(1.0 - float(res['distances'][0][0]), 4) if res and res.get('distances') else 0.0\n",
    "    doc_id = res['metadatas'][0][0].get('document_id', 'SOP') if res and res.get('metadatas') else 'SOP'\n",
    "    sec_t  = res['metadatas'][0][0].get('section_title', 'Policy') if res and res.get('metadatas') else 'Policy'\n",
    "    text_s = res['documents'][0][0].replace('\\n', ' ')[:130] if res and res.get('documents') else ''\n",
    "    \n",
    "    print(f\"\\n[Scenario {idx}]: {query}\")\n",
    "    print(f\"  📍 Retrieved Policy : [{doc_id}] {sec_t} (Cosine Confidence: {sim:.4f})\")\n",
    "    print(f\"  📖 Rule Excerpt     : {text_s}...\")"
   ]
