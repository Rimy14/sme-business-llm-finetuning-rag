    "## Cell 6 — Master Evolution Matrix Across All Versions (v1, v2, v3, v4, RAG)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "versions = [\"Base (Zero-Shot)\", \"v1 (SFT 2k Samples)\", \"v2 (+Synthetic Domain)\", \"v3 (RAG-Aware Context)\", \"v4 (Refined Multi-SOP)\", \"v4 + ChromaDB RAG\"]\n",
    "\n",
    "master_table = []\n",
    "for ver in versions:\n",
    "    q_m = HISTORICAL_PROGRESSION[\"qwen\"][ver]\n",
    "    l_m = HISTORICAL_PROGRESSION[\"llama\"][ver]\n",
    "    master_table.append([\n",
    "        ver,\n",
    "        f\"{q_m['rouge1']:.2f}%\", f\"{q_m['rougeL']:.2f}%\", f\"{q_m['bleu4']:.2f}\", f\"{q_m['bertscore']:.2f}%\传\".replace('传',''), f\"{q_m['latency_ms']}ms\",\n",
    "        f\"{l_m['rouge1']:.2f}%\", f\"{l_m['rougeL']:.2f}%\", f\"{l_m['bleu4']:.2f}\", f\"{l_m['bertscore']:.2f}%\传\".replace('传',''), f\"{l_m['latency_ms']}ms\"\n",
    "    ])\n",
    "\n",
    "print(\"\\n\" + \"=\"*110)\n",
    "print(\"🏆 DAY 11 MASTER SPRINT PERFORMANCE EVOLUTION MATRIX (ALL VERSIONS: BASE -> v1 -> v2 -> v3 -> v4 -> RAG)\")\n",
    "print(\"=\"*110)\n",
    "headers = [\"Version / Stage\", \"Qwen R-1\", \"Qwen R-L\", \"Qwen BLEU\", \"Qwen BERT\", \"Qwen Lat\", \"Llama R-1\", \"Llama R-L\", \"Llama BLEU\", \"Llama BERT\", \"Llama Lat\"]\n",
    "print(tabulate(master_table, headers=headers, tablefmt=\"fancy_grid\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7 — Calculate Total Sprint Lift (Base Model vs Final v4 + RAG)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "q_base = HISTORICAL_PROGRESSION[\"qwen\"][\"Base (Zero-Shot)\"]\n",
    "q_final = HISTORICAL_PROGRESSION[\"qwen\"][\"v4 + ChromaDB RAG\"]\n",
    "\n",
    "l_base = HISTORICAL_PROGRESSION[\"llama\"][\"Base (Zero-Shot)\"]\n",
    "l_final = HISTORICAL_PROGRESSION[\"llama\"][\"v4 + ChromaDB RAG\"]\n",
    "\n",
    "lift_table = [\n",
    "    [\"ROUGE-1\", f\"{q_base['rouge1']:.2f}%\", f\"{q_final['rouge1']:.2f}%\", f\"+{q_final['rouge1']-q_base['rouge1']:.2f}% 🚀\",\n",
    "                f\"{l_base['rouge1']:.2f}%\", f\"{l_final['rouge1']:.2f}%\", f\"+{l_final['rouge1']-l_base['rouge1']:.2f}% 🚀\"],\n",
    "    [\"ROUGE-2\", f\"{q_base['rouge2']:.2f}%\", f\"{q_final['rouge2']:.2f}%\", f\"+{q_final['rouge2']-q_base['rouge2']:.2f}% 🚀\",\n",
    "                f\"{l_base['rouge2']:.2f}%\", f\"{l_final['rouge2']:.2f}%\", f\"+{l_final['rouge2']-l_base['rouge2']:.2f}% 🚀\"],\n",
    "    [\"ROUGE-L\", f\"{q_base['rougeL']:.2f}%\", f\"{q_final['rougeL']:.2f}%\", f\"+{q_final['rougeL']-q_base['rougeL']:.2f}% 🚀\",\n",
    "                f\"{l_base['rougeL']:.2f}%\", f\"{l_final['rougeL']:.2f}%\", f\"+{l_final['rougeL']-l_base['rougeL']:.2f}% 🚀\"],\n",
    "    [\"BLEU-4\",  f\"{q_base['bleu4']:.2f}\",   f\"{q_final['bleu4']:.2f}\",   f\"+{q_final['bleu4']-q_base['bleu4']:.2f} 🚀\",\n",
    "                f\"{l_base['bleu4']:.2f}\",   f\"{l_final['bleu4']:.2f}\",   f\"+{l_final['bleu4']-l_base['bleu4']:.2f} 🚀\"],\n",
    "    [\"BERTScore\", f\"{q_base['bertscore']:.2f}%\", f\"{q_final['bertscore']:.2f}%\", f\"+{q_final['bertscore']-q_base['bertscore']:.2f}% 🚀\",\n",
    "                  f\"{l_base['bertscore']:.2f}%\", f\"{l_final['bertscore']:.2f}%\", f\"+{l_final['bertscore']-l_base['bertscore']:.2f}% 🚀\"]\n",
    "]\n",
    "\n",
    "print(\"\\n\" + \"=\"*95)\n",
    "print(\"🔥 TOTAL SPRINT NET GAIN & LIFT MATRIX (BASE ZERO-SHOT → FINAL v4 + RAG)\")\n",
    "print(\"=\"*95)\n",
    "print(tabulate(lift_table, headers=[\"Metric\", \"Qwen Base\", \"Qwen v4+RAG\", \"Qwen Total Gain\", \"Llama Base\", \"Llama v4+RAG\", \"Llama Total Gain\"], tablefmt=\"fancy_grid\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8 — Generate & Save Publication-Grade Evolution Charts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "eval_dir = os.path.join(PROJECT_ROOT, 'evaluation', 'day11')\n",
    "os.makedirs(eval_dir, exist_ok=True)\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\", font_scale=1.1)\n",
    "stages = [\"Base\", \"v1 (SFT)\", \"v2 (Synth)\", \"v3 (RAG-Ctx)\", \"v4 (Refined)\", \"v4 + RAG\"]\n",
    "\n",
    "q_r1 = [HISTORICAL_PROGRESSION[\"qwen\"][v][\"rouge1\"] for v in versions]\n",
    "q_rl = [HISTORICAL_PROGRESSION[\"qwen\"][v][\"rougeL\"] for v in versions]\n",
    "q_b4 = [HISTORICAL_PROGRESSION[\"qwen\"][v][\"bleu4\"] for v in versions]\n",
    "q_bs = [HISTORICAL_PROGRESSION[\"qwen\"][v][\"bertscore\"] for v in versions]\n",
    "\n",
    "l_r1 = [HISTORICAL_PROGRESSION[\"llama\"][v][\"rouge1\"] for v in versions]\n",
    "l_rl = [HISTORICAL_PROGRESSION[\"llama\"][v][\"rougeL\"] for v in versions]\n",
    "l_b4 = [HISTORICAL_PROGRESSION[\"llama\"][v][\"bleu4\"] for v in versions]\n",
    "l_bs = [HISTORICAL_PROGRESSION[\"llama\"][v][\"bertscore\"] for v in versions]\n",
    "\n",
    "# ── 1. Progression Curves (2x2 Subplots) ─────────────────────────────────────\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 11))\n",
    "\n",
    "# ROUGE-1\n",
    "axes[0, 0].plot(stages, q_r1, marker='o', linewidth=2.5, color='#1f77b4', label='Qwen 2.5-7B')\n",
    "axes[0, 0].plot(stages, l_r1, marker='s', linewidth=2.5, color='#ff7f0e', label='Llama 3 8B')\n",
    "axes[0, 0].set_title('ROUGE-1 Score Progression Across Versions (%)', fontweight='bold')\n",
    "axes[0, 0].set_ylabel('ROUGE-1 (%)')\n",
    "axes[0, 0].legend()\n",
    "\n",
    "# ROUGE-L\n",
    "axes[0, 1].plot(stages, q_rl, marker='o', linewidth=2.5, color='#1f77b4', label='Qwen 2.5-7B')\n",
    "axes[0, 1].plot(stages, l_rl, marker='s', linewidth=2.5, color='#ff7f0e', label='Llama 3 8B')\n",
    "axes[0, 1].set_title('ROUGE-L Score Progression Across Versions (%)', fontweight='bold')\n",
    "axes[0, 1].set_ylabel('ROUGE-L (%)')\n",
    "axes[0, 1].legend()\n",
    "\n",
    "# BLEU-4\n",
    "axes[1, 0].plot(stages, q_b4, marker='o', linewidth=2.5, color='#1f77b4', label='Qwen 2.5-7B')\n",
    "axes[1, 0].plot(stages, l_b4, marker='s', linewidth=2.5, color='#ff7f0e', label='Llama 3 8B')\n",
    "axes[1, 0].set_title('BLEU-4 Terminology Precision Progression', fontweight='bold')\n",
    "axes[1, 0].set_ylabel('BLEU-4')\n",
    "axes[1, 0].legend()\n",
    "\n",
    "# BERTScore\n",
    "axes[1, 1].plot(stages, q_bs, marker='o', linewidth=2.5, color='#1f77b4', label='Qwen 2.5-7B')\n",
    "axes[1, 1].plot(stages, l_bs, marker='s', linewidth=2.5, color='#ff7f0e', label='Llama 3 8B')\n",
    "axes[1, 1].set_title('BERTScore Semantic Alignment Progression (%)', fontweight='bold')\n",
    "axes[1, 1].set_ylabel('BERTScore (%)')\n",
    "axes[1, 1].legend()\n",
    "\n",
    "plt.suptitle('SME Daily Business LLM: Complete 11-Day Performance Evolution', fontsize=16, fontweight='bold', y=0.98)\n",
    "plt.tight_layout()\n",
    "\n",
    "chart1_path = os.path.join(eval_dir, 'all_versions_progression_chart.png')\n",
    "plt.savefig(chart1_path, dpi=300)\n",
    "plt.show()\n",
    "print(f\"✅ Saved Progression Chart: {chart1_path}\")\n",
    "\n",
    "# ── 2. Total Lift Comparison Bar Chart ───────────────────────────────────────\n",
    "metrics_names = ['ROUGE-1', 'ROUGE-2', 'ROUGE-L', 'BLEU-4', 'BERTScore']\n",
    "q_lifts = [q_final['rouge1']-q_base['rouge1'], q_final['rouge2']-q_base['rouge2'], q_final['rougeL']-q_base['rougeL'], q_final['bleu4']-q_base['bleu4'], q_final['bertscore']-q_base['bertscore']]\n",
    "l_lifts = [l_final['rouge1']-l_base['rouge1'], l_final['rouge2']-l_base['rouge2'], l_final['rougeL']-l_base['rougeL'], l_final['bleu4']-l_base['bleu4'], l_final['bertscore']-l_base['bertscore']]\n",
